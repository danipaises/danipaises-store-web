{
  "name": "nintendo-universe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "node scripts/validate-data.mjs",
    "coverage": "node scripts/coverage.mjs",
    "dev": "vite --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "tsx": "^4.19.0"
  }
}
